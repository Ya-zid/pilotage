{
  "name": "pilotage-cli",
  "version": "0.4.1",
  "description": "A local web cockpit for your Claude Code (and Codex / Gemini CLI) sessions: projects, live sessions, AI summaries, tasks, phone access.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "gemini-cli",
    "ai-coding",
    "dashboard",
    "developer-tools",
    "wsl",
    "macos",
    "linux"
  ],
  "author": "Yazid Slimani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ya-zid/pilotage.git"
  },
  "homepage": "https://github.com/Ya-zid/pilotage#readme",
  "bugs": {
    "url": "https://github.com/Ya-zid/pilotage/issues"
  },
  "bin": {
    "pilotage": "bin/pilotage"
  },
  "files": [
    "bin/",
    "server/",
    "web/dist/",
    "windows/",
    "docs/PHONE.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix web run build",
    "test": "node --test tests/*.test.js",
    "leak-scan": "bash scripts/leak-scan.sh",
    "prepack": "test ! -e server/local-workspaces.json || { echo 'server/local-workspaces.json is personal: pack from a clean clone'; exit 1; }; npm --prefix web run build"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "type": "module"
}
