{
  "name": "pilotage",
  "version": "0.2.0",
  "description": "A local web cockpit for your Claude Code (and Codex / Gemini CLI) sessions: projects, live sessions, AI summaries, tasks, phone access.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "gemini-cli",
    "ai-coding",
    "dashboard",
    "developer-tools",
    "wsl"
  ],
  "author": "Yazid Slimani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ya-zid/pilotage.git"
  },
  "homepage": "https://github.com/Ya-zid/pilotage#readme",
  "bugs": { "url": "https://github.com/Ya-zid/pilotage/issues" },
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix web run build",
    "test": "node --test tests/*.test.js",
    "leak-scan": "bash scripts/leak-scan.sh"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "type": "module",
  "private": true
}
